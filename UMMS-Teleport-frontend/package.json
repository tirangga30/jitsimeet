    "@capacitor/ios": "^7.4.4",
    "@capacitor/screen-orientation": "^7.0.2",
    "@jitsi/react-sdk": "^1.4.4",
    "@reduxjs/toolkit": "^2.10.1",
    "@yudiel/react-qr-scanner": "^2.4.1",
    "axios": "^1.18.1",
    "framer-motion": "^12.28.1",
    "primereact": "^10.9.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.66.1",
    "react-hot-toast": "^2.6.0",
