# UMMS Teleport REST API base URL. Include the /api prefix.
VITE_BACKEND_BASE_URL=http://localhost:4000/api

# Waiting-room and meeting-presence WebSocket server.
# Use wss:// when the deployed application is served over HTTPS.
VITE_WS_URL=ws://localhost:4000

# Jitsi hostname only (without https:// or a trailing slash).
VITE_JITSI_DOMAIN=meet.example.com
