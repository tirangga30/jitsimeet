# Application Configuration
PORT=4000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database Configuration
# Preferred: configure the connection with a single DATABASE_URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/umms_teleport?sslmode=disable"
DB_SSL=false

# Alternative: individual database configuration variables
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=umms_teleport
# DB_USER=postgres
# DB_PASSWORD=your-password

# Jitsi Meet Video Infrastructure
# Include protocol for JITSI_BASE_URL (without trailing slash).
JITSI_BASE_URL=https://meet.example.com
JITSI_DOMAIN=meet.example.com
JITSI_APP_ID=your-jitsi-app-id
JITSI_APP_SECRET=your-jitsi-app-secret

# Invitations Configuration
INVITATION_EXPIRY_HOURS=24

# DigitalOcean Spaces / S3 Compatible Storage
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_REGION=nyc3
DO_SPACES_BUCKET=your-bucket-name
DO_SPACES_KEY=your-spaces-key
DO_SPACES_SECRET=your-spaces-secret
# Storage Access Control: 'private' (default, generates secure presigned URLs) or 'public-read'
DO_SPACES_ACL=private

# TurboBridge SMS Gateway (Optional in local development)
TURBOSMS_USERNAME=your-username
TURBOSMS_PASSWORD=your-password
TURBOSMS_PARTNER_ID=your-partner-id
TURBOSMS_SENDER=your-sender-number

# External EMR Integration Service (Optional)
EMR_URL=https://emr.example.com
