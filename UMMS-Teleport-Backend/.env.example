# Application
PORT=4000

# PostgreSQL
# Preferred: configure the connection with one URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DB_SSL=true

# Alternative: use the individual values below when DATABASE_URL is unset.
# DB_HOST=your-db-host.db.ondigitalocean.com
# DB_PORT=25060
# DB_NAME=defaultdb
# DB_USER=doadmin
# DB_PASSWORD=your-password

# Jitsi Meet
# Include the protocol and do not include a trailing slash.
JITSI_BASE_URL=https://meet.example.com
JITSI_APP_ID=your-jitsi-app-id
JITSI_APP_SECRET=your-jitsi-app-secret

# Invitations
INVITATION_EXPIRY_HOURS=24

# DigitalOcean Spaces
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_REGION=nyc3
DO_SPACES_BUCKET=your-bucket-name
DO_SPACES_KEY=your-spaces-key
DO_SPACES_SECRET=your-spaces-secret

# TurboBridge SMS
TURBOSMS_USERNAME=your-username
TURBOSMS_PASSWORD=your-password
TURBOSMS_PARTNER_ID=your-partner-id
TURBOSMS_SENDER=your-sender-number

# External EMR service
EMR_URL=https://emr.example.com
